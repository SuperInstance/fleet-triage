{
  "name": "@quilt/pincher",
  "version": "0.1.0",
  "description": "A reflex engine built entirely from Quilt cells. Pinch in, match a reflex, execute. <50ms, no LLM, zero marginal cost. Federates across cloud, workstation, and ESP32.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsx --test test/*.test.ts",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^5.9.3",
    "tsx": "^4.7.0",
    "vitest": "^5.0.1",
    "eslint": "^10.11.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0"
  },
  "keywords": [
    "reflex",
    "vector-store",
    "llm-compiler",
    "quilt",
    "cells",
    "esp32",
    "edge",
    "agent"
  ],
  "engines": {
    "node": ">=18"
  }
}
