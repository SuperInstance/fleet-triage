{"fleet-platform-main/dashboard/index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Fleet Platform</title>\n<style>\n  :root {\n    --bg: #070b14; --panel: #0f1726; --border: #1e293b;\n    --accent: #06b6d4; --accent-dim: #0e7490;\n    --text: #e2e8f0; --dim: #64748b;\n    --ok: #10b981; --warn: #f59e0b; --crit: #ef4444;\n  }\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n  body { font-family: -apple-system, BlinkMacSystemFont, sans-serif; background: var(--bg); color: var(--text); padding: 20px; }\n  h1 { font-size: 1.5rem; margin-bottom: 4px; }\n  .subtitle { color: var(--dim); font-size: 0.875rem; margin-bottom: 24px; }\n  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }\n  .card {\n    background: var(--panel); border: 1px solid var(--border);\n    border-radius: 12px; padding: 20px; transition: border-color 0.15s;\n  }\n  .card:hover { border-color: var(--accent-dim); }\n  .card-title { font-size: 1rem; font-weight: 600; margin-bottom: 4px; display: flex; align-items: center; gap: 8px; }\n  .card-desc { color: var(--dim); font-size: 0.8rem; margin-bottom: 12px; }\n  .card-link { color: var(--accent); text-decoration: none; font-size: 0.8rem; }\n  .card-stats { display: flex; gap: 16px; margin-top: 12px; font-size: 0.75rem; color: var(--dim); }\n  .card-stats span strong { color: var(--text); }\n  .status-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }\n  .status-dot.ok { background: var(--ok); }\n  .status-dot.warn { background: var(--warn); }\n  .status-dot.down { background: var(--crit); }\n  .section { margin-bottom: 32px; }\n  .section-title { font-size: 1.1rem; font-weight: 600; margin-bottom: 12px; }\n  .api-key { font-family: monospace; font-size: 0.75rem; color: var(--accent); background: rgba(6,182,212,0.05); padding: 2px 6px; border-radius: 4px; }\n  .api-list { font-size: 0.75rem; color: var(--dim); margin-top: 8px; }\n  .api-list code { color: var(--accent); }\n  a { color: var(--accent); }\n</style>\n</head>\n<body>\n\n<h1>\ud83d\udea2 Fleet Platform</h1>\n<div class=\"subtitle\">SuperInstance Agency Tools \u2014 OracleClaw 24/7 Cloud Infrastructure</div>\n\n<div class=\"section\">\n  <div class=\"section-title\">\ud83d\udce1 Live Services</div>\n  <div class=\"grid\" id=\"services-grid\">\n\n    <div class=\"card\">\n      <div class=\"card-title\">\ud83c\udf10 Fleet API Gateway</div>\n      <div class=\"card-desc\">Single entry point for all agency data. Sessions, captures, training labels, search, brief.</div>\n      <div class=\"api-list\">\n        <code>GET /stats</code> \u00b7 <code>GET /brief</code> \u00b7 <code>GET /search?q=</code><br>\n        <code>POST /sessions</code> \u00b7 <code>POST /captures</code> \u00b7 <code>POST /training-labels</code><br>\n        <code>POST /weather/ingest</code> \u00b7 <code>POST /catch</code> \u00b7 <code>GET /health</code>\n      </div>\n      <div class=\"card-stats\">\n        <a href=\"https://api.fleet.superinstance.ai/stats\">\u2192 API Stats</a>\n      </div>\n    </div>\n\n    <div class=\"card\">\n      <div class=\"card-title\">\ud83c\udf26\ufe0f Fleet Weather</div>\n      <div class=\"card-desc\">Marine weather proxy + cache. NWS forecasts + NOAA tides. OracleClaw injects hourly.</div>\n      <div class=\"card-stats\">\n        <a href=\"https://weather.superinstance.ai/health\">\u2192 Health</a>\n        <span>\u00b7 hourly cron</span>\n      </div>\n    </div>\n\n    <div class=\"card\">\n      <div class=\"card-title\">\ud83c\udf99\ufe0f ActiveLog</div>\n      <div class=\"card-desc\">Essential domain-agnostic voice transcriber. Time + location annotations. Offline-first.</div>\n      <div class=\"card-stats\">\n        <a href=\"https://github.com/SuperInstance/activelog-app\">\u2192 GitHub</a>\n      </div>\n    </div>\n\n    <div class=\"card\">\n      <div class=\"card-title\">\ud83d\udc1f FishingLog.Ai</div>\n      <div class=\"card-desc\">Marine extension. Vessel NMEA, vocabulary feedback, camera deployment, catch linking.</div>\n      <div class=\"card-stats\">\n        <a href=\"https://github.com/SuperInstance/fishinglog-ai\">\u2192 GitHub</a>\n      </div>\n    </div>\n\n    <div class=\"card\">\n      <div class=\"card-title\">\ud83e\udde9 Polyformalism A2A</div>\n      <div class=\"card-desc\">9-channel intent protocol for multi-agent alignment. Every fleet message tagged with intent vectors.</div>\n      <div class=\"card-stats\">\n        <a href=\"https://github.com/SuperInstance/polyformalism-a2a-js\">\u2192 GitHub</a>\n      </div>\n    </div>\n\n    <div class=\"card\">\n      <div class=\"card-title\">\ud83d\udcca Ship Log Search</div>\n      <div class=\"card-desc\">D1 + Vectorize logbook. Semantic + spatial + timeline search across all vessel data.</div>\n      <div class=\"card-stats\">\n        <a href=\"https://ship-log-search.casey-digennaro.workers.dev\">\u2192 Open</a>\n      </div>\n    </div>\n\n  </div>\n</div>\n\n<div class=\"section\">\n  <div class=\"section-title\">\ud83e\udd16 Agent Directory</div>\n  <div class=\"grid\">\n    <div class=\"card\">\n      <div class=\"card-title\">\ud83d\udd2e OracleClaw</div>\n      <div class=\"card-desc\">The cloud position. 24/7 uptime, unlimited internet. Weather injection, morning brief, narrator analysis. Runs while the boat sleeps.</div>\n      <div class=\"card-stats\">\n        <span class=\"status-dot ok\"></span> <span>Active</span>\n        <span>\u00b7 Model: GLM-5.2</span>\n      </div>\n    </div>\n\n    <div class=\"card\">\n      <div class=\"card-title\">\ud83e\udd80 Hermes Agent</div>\n      <div class=\"card-desc\">Boots on the ground. Nav computer. Sounder captures, bathy data, prior track lines. Stream alignment + gap detection.</div>\n      <div class=\"card-stats\">\n        <span class=\"status-dot ok\"></span> <span>On vessel (EILEEN)</span>\n      </div>\n    </div>\n\n    <div class=\"card\">\n      <div class=\"card-title\">\ud83d\udc41\ufe0f TZ-Pro Agent</div>\n      <div class=\"card-desc\">The vessel nervous system. Capture daemon, analyzer.py, vocabulary module, alerts. 21K+ blobs catalogued.</div>\n      <div class=\"card-stats\">\n        <span class=\"status-dot ok\"></span> <span>On vessel (EILEEN)</span>\n      </div>\n    </div>\n  </div>\n</div>\n\n<div class=\"section\">\n  <div class=\"section-title\">\ud83d\udcda Repositories</div>\n  <div class=\"grid\">\n    <div class=\"card\">\n      <div class=\"card-title\"> activelog-app</div>\n      <div class=\"card-desc\">Essential core transcriber</div>\n      <a class=\"card-link\" href=\"https://github.com/SuperInstance/activelog-app\">\u2192 GitHub</a>\n    </div>\n    <div class=\"card\">\n      <div class=\"card-title\"> fishinglog-ai</div>\n      <div class=\"card-desc\">Marine extension</div>\n      <a class=\"card-link\" href=\"https://github.com/SuperInstance/fishinglog-ai\">\u2192 GitHub</a>\n    </div>\n    <div class=\"card\">\n      <div class=\"card-title\"> activelog-ai</div>\n      <div class=\"card-desc\">Integration docs + Hermes onboarding</div>\n      <a class=\"card-link\" href=\"https://github.com/SuperInstance/activelog-ai\">\u2192 GitHub</a>\n    </div>\n    <div class=\"card\">\n      <div class=\"card-title\"> fleet-weather</div>\n      <div class=\"card-desc\">Weather proxy worker</div>\n      <a class=\"card-link\" href=\"https://github.com/SuperInstance/fleet-weather\">\u2192 GitHub</a>\n    </div>\n    <div class=\"card\">\n      <div class=\"card-title\"> tzpro-agent</div>\n      <div class=\"card-desc\">Vessel nervous system</div>\n      <a class=\"card-link\" href=\"https://github.com/SuperInstance/tzpro-agent\">\u2192 GitHub</a>\n    </div>\n    <div class=\"card\">\n      <div class=\"card-title\"> ship-log-modules</div>\n      <div class=\"card-desc\">13 vessel modules + Vessel Quest</div>\n      <a class=\"card-link\" href=\"https://github.com/SuperInstance/ship-log-modules\">\u2192 GitHub</a>\n    </div>\n    <div class=\"card\">\n      <div class=\"card-title\"> polyformalism-a2a-js</div>\n      <div class=\"card-desc\">9-channel agent communication</div>\n      <a class=\"card-link\" href=\"https://github.com/SuperInstance/polyformalism-a2a-js\">\u2192 GitHub</a>\n    </div>\n    <div class=\"card\">\n      <div class=\"card-title\"> fleet-platform</div>\n      <div class=\"card-desc\">This dashboard + deploy scripts</div>\n      <a class=\"card-link\" href=\"https://github.com/SuperInstance/fleet-platform\">\u2192 GitHub</a>\n    </div>\n  </div>\n</div>\n\n<script>\n// Fetch live stats\nfetch('https://api.fleet.superinstance.ai/stats')\n  .then(r => r.json())\n  .then(data => {\n    // Could update cards with live data\n    console.log('Fleet stats:', data);\n  })\n  .catch(() => {});\n</script>\n</body>\n</html>\n"}