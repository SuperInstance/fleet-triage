diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
new file mode 100644
index 0000000..92b4535
--- /dev/null
+++ b/.github/workflows/ci.yml
@@ -0,0 +1,29 @@
+name: CI
+
+on:
+  push:
+    branches: [ "main" ]
+  pull_request:
+    branches: [ "main" ]
+
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-node@v4
+        with:
+          node-version: "22"
+
+      # `npm install` is expected to FAIL on the repos that declare
+      # "@superinstance/observation-primitive": "file:../observation-primitive"
+      # -- observation-primitive is not a published package and not a sibling
+      # checkout on a fresh runner. That failure is real and is left visible.
+      # Do NOT add `|| true`, `continue-on-error:` or `set +e` here: a green
+      # tick on a harness that never ran is the exact defect this file closes.
+      - name: Install dependencies
+        run: npm install
+
+      - name: Run tests
+        run: npm test
