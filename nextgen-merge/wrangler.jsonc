{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nextgen-merge",
  "main": "src/index.js",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "BRANCHES", "class_name": "Branch" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Branch"]
    }
  ]
}
